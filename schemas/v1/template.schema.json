{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sticker-assets:v1:template",
  "title": "轻模板 templates/<id>/<version>/template.json（声明式，B 的 light-v1 渲染器执行，不含代码）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "status",
    "renderer",
    "tags",
    "inputs",
    "params",
    "output",
    "canvas",
    "layers",
    "files",
    "fonts",
    "licenseIds",
    "notice"
  ],
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -2048,
          "maximum": 2048
        },
        "y": {
          "type": "integer",
          "minimum": -2048,
          "maximum": 2048
        },
        "w": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "h": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      }
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"
    },
    "relPath": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,47}\\.(png|jpg|gif)$"
    },
    "quad": {
      "description": "Perspective dest corners in local source space, order TL→TR→BR→BL (same as pil-utils). May extend outside the source.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number",
          "minimum": -4096,
          "maximum": 4096
        }
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "param",
        "in"
      ],
      "properties": {
        "param": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "flip": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical",
        "both"
      ]
    },
    "fromX": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ],
      "default": "left"
    },
    "fromY": {
      "type": "string",
      "enum": [
        "top",
        "bottom"
      ],
      "default": "top"
    },
    "keyframe": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "box": {
              "$ref": "#/$defs/box"
            },
            "rotate": {
              "type": "number",
              "minimum": -3600,
              "maximum": 3600
            },
            "quad": {
              "$ref": "#/$defs/quad"
            },
            "visible": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "urn:sticker-assets:v1:common#/$defs/templateId"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "renderer": {
      "const": "light-v1"
    },
    "tags": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:sticker-assets:v1:common#/$defs/tag"
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "texts",
        "images"
      ],
      "properties": {
        "texts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max",
            "maxLength"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            }
          }
        }
      }
    },
    "params": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "default"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]{0,23}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "integer",
              "boolean",
              "enum"
            ]
          },
          "default": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          },
          "enum": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 32
            }
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          },
          "maxLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime",
        "animated",
        "maxBytes"
      ],
      "properties": {
        "mime": {
          "type": "string",
          "enum": [
            "image/png",
            "image/gif"
          ]
        },
        "animated": {
          "type": "boolean"
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2097152
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "background"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "background": {
          "anyOf": [
            {
              "$ref": "#/$defs/color"
            },
            {
              "type": "null"
            }
          ]
        },
        "fit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slot",
            "mode"
          ],
          "description": "Size the canvas from a slot image at render time. width/height on canvas are the default/target; fit clamps the resolved size.",
          "properties": {
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            },
            "mode": {
              "type": "string",
              "enum": [
                "contain",
                "cover",
                "width",
                "height"
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "minWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "maxWidth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "minHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            },
            "maxHeight": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048
            }
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "file",
              "box"
            ],
            "properties": {
              "type": {
                "const": "image"
              },
              "file": {
                "$ref": "#/$defs/relPath"
              },
              "box": {
                "$ref": "#/$defs/box"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23,
                "description": "Only draw on this animation frame; omit to draw on every frame (unless keyframes hide it)."
              },
              "flip": {
                "$ref": "#/$defs/flip"
              },
              "when": {
                "$ref": "#/$defs/when"
              },
              "xFrom": {
                "$ref": "#/$defs/fromX"
              },
              "yFrom": {
                "$ref": "#/$defs/fromY"
              },
              "fill": {
                "type": "boolean",
                "description": "Stretch this layer to the resolved canvas (variable-canvas templates)."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "slot",
              "box",
              "fit"
            ],
            "properties": {
              "type": {
                "const": "slot-image"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "box": {
                "$ref": "#/$defs/box"
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover"
                ]
              },
              "rotate": {
                "type": "number",
                "minimum": -3600,
                "maximum": 3600,
                "description": "Degrees clockwise around box center; omit or 0 for none"
              },
              "clip": {
                "type": "string",
                "enum": [
                  "rect",
                  "circle"
                ],
                "default": "rect",
                "description": "Clip slot image to rectangle (default) or inscribed circle"
              },
              "quad": {
                "$ref": "#/$defs/quad"
              },
              "keyframes": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/keyframe"
                },
                "description": "Per-frame box/rotate/quad/visibility. A null entry hides the slot on that frame. Missing trailing frames are hidden."
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23,
                "description": "Only draw on this animation frame; omit to draw on every frame (unless keyframes hide it)."
              },
              "flip": {
                "$ref": "#/$defs/flip"
              },
              "when": {
                "$ref": "#/$defs/when"
              },
              "xFrom": {
                "$ref": "#/$defs/fromX"
              },
              "yFrom": {
                "$ref": "#/$defs/fromY"
              },
              "fill": {
                "type": "boolean",
                "description": "Stretch this layer to the resolved canvas (variable-canvas templates)."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "slot",
              "box",
              "font",
              "fontSize",
              "minFontSize",
              "color",
              "stroke",
              "align",
              "valign",
              "wrap"
            ],
            "properties": {
              "type": {
                "const": "text"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "box": {
                "$ref": "#/$defs/box"
              },
              "font": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
              },
              "fontSize": {
                "type": "integer",
                "minimum": 6,
                "maximum": 256
              },
              "minFontSize": {
                "type": "integer",
                "minimum": 6,
                "maximum": 256
              },
              "color": {
                "$ref": "#/$defs/color"
              },
              "stroke": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "color",
                      "width"
                    ],
                    "properties": {
                      "color": {
                        "$ref": "#/$defs/color"
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      }
                    }
                  }
                ]
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              },
              "valign": {
                "type": "string",
                "enum": [
                  "top",
                  "middle",
                  "bottom"
                ]
              },
              "wrap": {
                "type": "boolean"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 23
              },
              "when": {
                "$ref": "#/$defs/when"
              },
              "xFrom": {
                "$ref": "#/$defs/fromX"
              },
              "yFrom": {
                "$ref": "#/$defs/fromY"
              },
              "rotate": {
                "type": "number",
                "minimum": -3600,
                "maximum": 3600
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "files",
              "box"
            ],
            "properties": {
              "type": {
                "const": "image-sequence"
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "$ref": "#/$defs/relPath"
                },
                "description": "files[i] is drawn on animation frame i, in the same box."
              },
              "box": {
                "$ref": "#/$defs/box"
              },
              "flip": {
                "$ref": "#/$defs/flip"
              },
              "when": {
                "$ref": "#/$defs/when"
              },
              "xFrom": {
                "$ref": "#/$defs/fromX"
              },
              "yFrom": {
                "$ref": "#/$defs/fromY"
              },
              "fill": {
                "type": "boolean",
                "description": "Stretch this layer to the resolved canvas (variable-canvas templates)."
              }
            }
          }
        ]
      }
    },
    "files": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "mime",
          "role"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relPath"
          },
          "sha256": {
            "$ref": "urn:sticker-assets:v1:common#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2097152
          },
          "mime": {
            "$ref": "urn:sticker-assets:v1:common#/$defs/mime"
          },
          "role": {
            "type": "string",
            "enum": [
              "base",
              "overlay",
              "frame"
            ]
          }
        }
      }
    },
    "fonts": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "licenseId",
          "providedBy"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "licenseId": {
            "$ref": "urn:sticker-assets:v1:common#/$defs/licenseId"
          },
          "providedBy": {
            "type": "string",
            "enum": [
              "renderer"
            ]
          }
        }
      }
    },
    "licenseIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:sticker-assets:v1:common#/$defs/licenseId"
      }
    },
    "notice": {
      "type": "string",
      "maxLength": 2000
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "面向用户的短说明（中文）；长篇权利声明请放 license + source，勿塞进 notice。"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project",
        "memeId",
        "url",
        "commit"
      ],
      "properties": {
        "kind": {
          "const": "meme-generator"
        },
        "project": {
          "type": "string",
          "maxLength": 120
        },
        "memeId": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "url": {
          "type": "string",
          "maxLength": 400,
          "pattern": "^https://github\\.com/"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "description": "机读来源（不面向展示）。MIT 权利说明见 licenses/meme-generator-mit.json。"
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameCount",
        "frameDurationMs"
      ],
      "description": "When present, the template is rendered once per frame and encoded as a GIF. output.mime must be image/gif and output.animated true.",
      "properties": {
        "frameCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "frameDurationMs": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000
        },
        "loop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "default": 0,
          "description": "0 = loop forever"
        }
      }
    }
  }
}
