{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sticker-assets:v1:index-terms",
  "title": "indexes/terms/<tt>.json 倒排分片",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "indexFormat", "shard", "terms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "indexFormat": { "const": 1 },
    "shard": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
    "terms": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [ { "type": "string", "pattern": "^[0-9a-f]{12}$" }, { "type": "integer", "minimum": 1, "maximum": 100 } ]
        }
      }
    }
  }
}
