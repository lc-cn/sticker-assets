{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sticker-assets:v1:manifest-shard",
  "title": "manifest 分片 manifests/<hh>.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "shard", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "shard": { "type": "string", "pattern": "^[0-9a-f]{2}$" },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "urn:sticker-assets:v1:asset" } }
  }
}
