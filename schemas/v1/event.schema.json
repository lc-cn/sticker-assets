{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sticker-assets:v1:event",
  "title": "最小操作事件 events/<oo>/<operationId>.json（不含身份/原始key）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationId", "type", "occurredAt", "actorKind", "idempotency", "requestFingerprint", "assets", "summary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operationId": { "$ref": "urn:sticker-assets:v1:common#/$defs/operationId" },
    "type": { "type": "string", "enum": ["asset.create", "asset.update", "asset.archive", "asset.tombstone", "asset.restore", "asset.review", "template.publish", "index.rebuild", "import.batch"] },
    "occurredAt": { "$ref": "urn:sticker-assets:v1:common#/$defs/utcTime" },
    "actorKind": { "type": "string", "enum": ["admin", "machine", "actions"] },
    "idempotency": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyId", "keyHmac"],
          "properties": {
            "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
            "keyHmac": { "$ref": "urn:sticker-assets:v1:common#/$defs/sha256" }
          }
        }
      ]
    },
    "requestFingerprint": { "anyOf": [ { "type": "null" }, { "$ref": "urn:sticker-assets:v1:common#/$defs/hmacRef" } ] },
    "assets": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "revision"],
        "properties": {
          "id": { "$ref": "urn:sticker-assets:v1:common#/$defs/assetId" },
          "revision": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "added": { "type": "integer", "minimum": 0 },
        "addedBytes": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "removed": { "type": "integer", "minimum": 0 },
        "templateId": { "$ref": "urn:sticker-assets:v1:common#/$defs/templateId" },
        "templateVersion": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
